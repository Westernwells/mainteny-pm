{
  "name": "create-react-app-with-typescript",
  "version": "5.0.0",
  "private": true,
  "homepage": "/pm",
  "dependencies": {
    "@emotion/react": "latest",
    "@emotion/styled": "latest",
    "@mui/base": "^5.0.0-alpha.66",
    "@mui/icons-material": "^5.2.1",
    "@mui/lab": "^5.0.0-alpha.63",
    "@mui/material": "^5.4.1",
    "@mui/styles": "^5.2.3",
    "@mui/system": "^5.2.3",
    "@mui/x-data-grid": "^5.5.1",
    "@mui/x-date-pickers": "^5.0.0-beta.3",
    "@reduxjs/toolkit": "^1.6.2",
    "@types/lodash": "^4.14.178",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axios": "^0.24.0",
    "base64-arraybuffer": "^1.0.2",
    "chart.js": "^3.6.2",
    "date-fns": "^2.27.0",
    "dinero.js": "^1.9.1",
    "env-cmd": "^10.1.0",
    "formik": "^2.2.9",
    "geolib": "^3.3.3",
    "google-map-react": "^2.1.10",
    "i18next": "^21.8.16",
    "i18next-browser-languagedetector": "^6.1.4",
    "i18next-http-backend": "^1.4.1",
    "lint-staged": ">=10",
    "lodash": "^4.17.21",
    "mixpanel-browser": "^2.45.0",
    "mui-address-autocomplete": "^2.2.1",
    "notistack": "^2.0.3",
    "pusher-js": "^7.4.0",
    "query-string": "^7.0.1",
    "react": "latest",
    "react-chartjs-2": "^4.0.0",
    "react-cropper": "^2.1.8",
    "react-dom": "latest",
    "react-dropzone": "^14.2.1",
    "react-easy-crop": "^4.1.4",
    "react-helmet": "^6.1.0",
    "react-i18next": "^11.18.3",
    "react-pdf": "^5.6.0",
    "react-query": "^3.34.1",
    "react-redux": "^7.2.6",
    "react-router-dom": "^6.0.2",
    "react-scripts": "latest",
    "react-top-loading-bar": "^2.1.0",
    "supercluster": "^7.1.5",
    "typescript": "latest",
    "use-supercluster": "^0.4.0",
    "yup": "^0.32.11",
    "zustand": "^4.0.0"
  },
  "scripts": {
    "prepare_env": "node create_env.mjs",
    "start": "react-scripts start",
    "start:stage": "env-cmd -f .env.stage react-scripts start",
    "start:prod": "env-cmd -f .env.prod react-scripts start",
    "build:stage": "env-cmd -f .env.stage react-scripts build",
    "build:prod": "env-cmd -f .env.prod react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "prepare": "husky install",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint . --ext ts --ext tsx --ext js",
    "format": "prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/dinero.js": "^1.9.0",
    "@types/google-map-react": "^2.1.3",
    "@types/mixpanel-browser": "^2.38.0",
    "@types/react-helmet": "^6.1.5",
    "@types/react-pdf": "^5.0.9",
    "@types/supercluster": "^7.1.0",
    "@typescript-eslint/eslint-plugin": "^5.6.0",
    "@typescript-eslint/parser": "^5.6.0",
    "eslint-config-airbnb": "^19.0.2",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.2.0",
    "eslint-plugin-react": "^7.27.1",
    "eslint-plugin-react-hooks": "^4.3.0",
    "husky": "^7.0.0",
    "prettier": "^2.5.1"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx}": [
      "eslint . --fix"
    ],
    "*.{js,ts,tsx}": "prettier --write"
  }
}
